# ==========================================
# 全栈项目终极版 .gitignore (Node + Go + Java + Python)
# ==========================================

# --- [1. 前端/Node.js 相关] ---
node_modules/
dist/
out/
.next/
.nuxt/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- [2. Go 后端相关 (直播/高并发)] ---
bin/
*.exe
*.exe_
*.dll
*.so
*.dylib
vendor/
*.test
*.out

# --- [3. Python 后端相关 (AI/视频生成)] ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.coverage
# 忽略巨大的 AI 模型权重文件 (建议放在对象存储或服务器指定目录)
*.pth
*.pkl
*.h5
*.onnx
*.weights

# --- [4. Java 后端相关 (业务逻辑)] ---
*.class
*.jar
*.war
*.ear
target/
.gradle/
.settings/
.classpath
.project

# --- [5. 本地环境与隐私 (重中之重)] ---
# 保护你的数据库密码、API Key 以及私密项目配置
.env
.env.local
.env.*.local
*.pem
*.key

# --- [6. 系统与 IDE 缓存] ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sw?