# ==========================================================
# 全能型 Docker 忽略清单 (前端 + Go + Python + Java)
# ==========================================================

# --- 1. 忽略通用的开发工具与系统缓存 ---
.git
.gitignore
.github
.vscode
.idea
.DS_Store
Thumbs.db
*.sw?
*.log

# --- 2. 前端相关 (Node.js) ---
node_modules/
**/node_modules/
dist/
build/
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*

# --- 3. Python 相关 (AI/视频生成) ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.pytest_cache/
.coverage
*.pth
# 忽略巨大的 AI 模型文件，建议通过卷(Volume)挂载
*.weights
*.onnx
*.pth

# --- 4. Go 相关 (直播流) ---
bin/
*.test
*.out
vendor/

# --- 5. Java 相关 (业务后台) ---
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/
*.tlog
*.log

# --- 6. 本地敏感信息 (绝对不能打进镜像) ---
.env
.env.local
.env.*.local
*.pem
*.key